# Use development-only Clerk and Neon values locally. Never place production values in Vercel Preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# 32+ random bytes, e.g. `openssl rand -base64 32`; never rotate while an active pairing code exists.
LUSTRE_PAIRING_PEPPER=
# The exact browser/API origin accepted by the device-signature protocol.
LUSTRE_CLOUD_ORIGIN=http://localhost:3000
# A 32-byte random value used to sign short-lived device session tokens.
LUSTRE_DEVICE_TOKEN_SECRET=
