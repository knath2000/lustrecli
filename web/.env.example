# Use development-only Clerk and Neon values locally. Never place production values in Vercel Preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# 32+ random bytes, e.g. `openssl rand -base64 32`; never rotate while an active pairing code exists.
LUSTRE_PAIRING_PEPPER=
# The exact browser/API origin accepted by the device-signature protocol.
LUSTRE_CLOUD_ORIGIN=http://localhost:3000
# A 32-byte random value used to sign short-lived device session tokens.
LUSTRE_DEVICE_TOKEN_SECRET=
# Lustre Watch cloud extraction. Keep Modal proxy and signing credentials server-only.
RESOLVER_ORIGIN=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
# MP4 staging stays disabled unless this is exactly true.
LUSTRE_CLOUD_STAGING_ENABLED=false
LUSTRE_STAGING_TOKEN_SECRET=
STAGING_ORIGIN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=
ASSET_WORKER_ORIGIN=
ASSET_TICKET_SECRET=
