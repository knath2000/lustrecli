{
  "manifest_version": 3,
  "name": "Lustre Watch Provider Capture",
  "version": "1.4.0",
  "description": "Provides browser-assisted feeds and playback sources for Lustre Watch.",
  "permissions": ["tabs", "scripting", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["media-candidate.js", "background.js"]
  },
  "content_scripts": [{
    "matches": ["https://lustre-watch.vercel.app/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "provider-capture@lustre-watch.vercel.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
