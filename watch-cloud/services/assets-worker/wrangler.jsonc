{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lustrecli-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WEB_ORIGIN": "https://lustrecli.vercel.app"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
