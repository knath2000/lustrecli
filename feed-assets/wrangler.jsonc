{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lustre-feed-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://lustrecli.vercel.app"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
